# Multi-stage production container for Harvesto Database Migration Runner
# Stage 1: Dependency resolution
FROM node:20-alpine AS dependencies
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY backend/package*.json ./backend/
WORKDIR /app/backend
RUN npm ci --omit=dev --no-audit --prefer-offline

# Stage 2: Final runtime runner
FROM node:20-alpine AS runner
WORKDIR /app

ARG VERSION=1.0.0
ARG BUILD_DATE
ARG GIT_COMMIT

LABEL maintainer="Harvesto DevOps Team <manerameshwar909@gmail.com>"
LABEL org.opencontainers.image.title="Harvesto Database Migration"
LABEL org.opencontainers.image.description="Automated database migration runner for Harvesto MongoDB"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
LABEL version="${VERSION}"

ENV NODE_ENV=production

# Copy installed production dependencies
COPY --from=dependencies /app/backend/node_modules ./backend/node_modules
COPY backend/package.json ./backend/package.json

# Copy migration scripts and application models
COPY backend/migrations ./backend/migrations
COPY backend/scripts ./backend/scripts
COPY backend/models ./backend/models
COPY backend/configs ./backend/configs

# Run as unprivileged node user
USER node

ENTRYPOINT ["node", "backend/scripts/migrate.js", "up"]
